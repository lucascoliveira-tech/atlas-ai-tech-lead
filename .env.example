# ATLAS frontend mode. "demo" (default) runs entirely offline with fictitious data.
# "api" requires a valid VITE_API_BASE_URL and talks exclusively to atlas-core-api.
# An unset value falls back to "demo"; any other value is a configuration error.
VITE_ATLAS_MODE=demo

# Required only when VITE_ATLAS_MODE=api. Base URL of atlas-core-api used by the browser build
# (npm run build / preview). During `npm run dev`, requests to /api are proxied by Vite to this
# same URL (see vite.config.js), which avoids browser CORS restrictions in local development,
# since atlas-core-api does not configure CORS today.
# HTTP is only accepted for localhost/127.0.0.1; hosted backends must use HTTPS.
# Never put tokens, credentials or secrets in VITE_* variables: they are bundled into the client build.
VITE_API_BASE_URL=http://localhost:8080
